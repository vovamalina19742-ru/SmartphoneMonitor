<Application x:Class="SmartphoneMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:SmartphoneMonitor.Converters"
             xmlns:smartphonemonitor="clr-namespace:SmartphoneMonitor"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <cv:BoolToVisibilityConverter x:Key="BoolVis" />
      <cv:BoolToHiddenConverter x:Key="BoolHide" />
      <cv:BoolToColorConverter x:Key="BoolColor" />
      <cv:ZeroToHiddenConverter x:Key="ZeroHide" />
      <cv:IntEqualsConverter x:Key="IntEq" />
      <cv:IntEqToBrushConverter x:Key="IntEqBg" />
      <cv:IntEqToFgConverter x:Key="IntEqFg" />
      <SolidColorBrush x:Key="Primary" Color="#1565C0" />
      <SolidColorBrush x:Key="PrimaryL" Color="#1976D2" />
      <SolidColorBrush x:Key="Accent" Color="#43A047" />
      <SolidColorBrush x:Key="Warn" Color="#FB8C00" />
      <SolidColorBrush x:Key="Danger" Color="#E53935" />
      <SolidColorBrush x:Key="BgPage" Color="#F0F4F8" />
      <SolidColorBrush x:Key="BgCard" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BgStripe" Color="#F5F8FF" />
      <SolidColorBrush x:Key="TextMain" Color="#1A1A2E" />
      <SolidColorBrush x:Key="TextSub" Color="#6B7280" />
      <SolidColorBrush x:Key="Border" Color="#E2E8F0" />
      <Style x:Key="Btn" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource Primary}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="24,10" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="8" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource PrimaryL}" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Background" Value="#B0BEC5" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="BtnDanger" TargetType="{x:Type Button}" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource Danger}" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#EF5350" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Background" Value="#B0BEC5" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="BtnSm" TargetType="{x:Type Button}" BasedOn="{StaticResource Btn}">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="12" />
      </Style>
      <Style x:Key="BtnPill" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#EEF2FF" />
        <Setter Property="Foreground" Value="{StaticResource Primary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bd" Background="{TemplateBinding Control.Background}" CornerRadius="20" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="#D0D8FF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Property="Border.Background" Value="#E5E7EB" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="BtnPillSel" TargetType="{x:Type Button}" BasedOn="{StaticResource BtnPill}">
        <Setter Property="Background" Value="{StaticResource Primary}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
      </Style>
      <Style x:Key="TB" TargetType="{x:Type TextBox}">
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Border Background="#FFFFFFFF" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="6">
                <ScrollViewer Name="PART_ContentHost" Margin="{TemplateBinding Control.Padding}" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TC" TargetType="{x:Type TabControl}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabControl}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Padding="16,0" Background="{StaticResource Primary}">
                  <TabPanel Name="HeaderPanel" IsItemsHost="True" Background="#00FFFFFF" />
                </Border>
                <Border Grid.Row="1" Padding="16" Background="{StaticResource BgPage}">
                  <ContentPresenter Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                </Border>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TI" TargetType="{x:Type TabItem}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabItem}">
              <Border Name="Bd" Background="#00FFFFFF" Padding="16,12">
                <TextBlock Text="{TemplateBinding HeaderedContentControl.Header}" FontSize="13" FontWeight="SemiBold" Foreground="#99FFFFFF" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="TabItem.IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="#22FFFFFF" />
                  <Setter Property="TextElement.Foreground" Value="#FFFFFFFF" />
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="#11FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
