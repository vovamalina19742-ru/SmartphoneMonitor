<Window x:Class="SmartphoneMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="999.md — Мониторинг рынка смартфонов (1 000–5 000 лей)"
        Width="1180" Height="800" MinWidth="960" MinHeight="650"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Background="{StaticResource BgPage}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="4" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Background="{StaticResource Primary}" Padding="24,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="📱" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />
          <StackPanel>
            <TextBlock Text="Мониторинг рынка смартфонов" FontSize="18" FontWeight="Bold" Foreground="#FFFFFFFF" />
            <TextBlock Text="999.md · Новые и Б/У · Все бренды · 1 000–5 000 лей" FontSize="11" Foreground="#AACFFF" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" CornerRadius="12" Padding="14,5" Background="{Binding IsBusy, Converter={StaticResource BoolColor}}">
          <TextBlock Foreground="#FFFFFFFF" FontSize="12" FontWeight="SemiBold" Text="{Binding Status}" />
        </Border>
      </Grid>
    </Border>
    <TabControl Grid.Row="1" Style="{StaticResource TC}">
      <TabItem Header="🔍 Анализ" Style="{StaticResource TI}">
        <ScrollViewer>
          <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="24" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Параметры парсинга" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,16" />
                <TextBlock Text="Количество страниц для сбора данных:" FontSize="13" Foreground="{StaticResource TextSub}" Margin="0,0,0,10" />
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <Button Content="1 стр." CommandParameter="1" Command="{Binding SetPagesCommand}" IsEnabled="{Binding IsReady}">
                    <FrameworkElement.Style>
                      <Style BasedOn="{StaticResource BtnPill}" TargetType="{x:Type Button}">
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding MaxPages, Converter={StaticResource IntEq}, ConverterParameter=1}">
                            <Setter Property="Background" Value="{StaticResource Primary}" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </Button>
                  <Button Content="5 стр." CommandParameter="5" Command="{Binding SetPagesCommand}" IsEnabled="{Binding IsReady}">
                    <FrameworkElement.Style>
                      <Style BasedOn="{StaticResource BtnPill}" TargetType="{x:Type Button}">
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding MaxPages, Converter={StaticResource IntEq}, ConverterParameter=5}">
                            <Setter Property="Background" Value="{StaticResource Primary}" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </Button>
                  <Button Content="10 стр." CommandParameter="10" Command="{Binding SetPagesCommand}" IsEnabled="{Binding IsReady}">
                    <FrameworkElement.Style>
                      <Style BasedOn="{StaticResource BtnPill}" TargetType="{x:Type Button}">
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding MaxPages, Converter={StaticResource IntEq}, ConverterParameter=10}">
                            <Setter Property="Background" Value="{StaticResource Primary}" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </Button>
                  <Button Content="20 стр." CommandParameter="20" Command="{Binding SetPagesCommand}" IsEnabled="{Binding IsReady}">
                    <FrameworkElement.Style>
                      <Style BasedOn="{StaticResource BtnPill}" TargetType="{x:Type Button}">
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding MaxPages, Converter={StaticResource IntEq}, ConverterParameter=20}">
                            <Setter Property="Background" Value="{StaticResource Primary}" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </Button>
                  <Button Content="30 стр." CommandParameter="30" Command="{Binding SetPagesCommand}" IsEnabled="{Binding IsReady}">
                    <FrameworkElement.Style>
                      <Style BasedOn="{StaticResource BtnPill}" TargetType="{x:Type Button}">
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding MaxPages, Converter={StaticResource IntEq}, ConverterParameter=30}">
                            <Setter Property="Background" Value="{StaticResource Primary}" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </Button>
                  <Button Content="40 стр." CommandParameter="40" Command="{Binding SetPagesCommand}" IsEnabled="{Binding IsReady}">
                    <FrameworkElement.Style>
                      <Style BasedOn="{StaticResource BtnPill}" TargetType="{x:Type Button}">
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding MaxPages, Converter={StaticResource IntEq}, ConverterParameter=40}">
                            <Setter Property="Background" Value="{StaticResource Primary}" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </Button>
                  <Button Content="50 стр." CommandParameter="50" Command="{Binding SetPagesCommand}" IsEnabled="{Binding IsReady}">
                    <FrameworkElement.Style>
                      <Style BasedOn="{StaticResource BtnPill}" TargetType="{x:Type Button}">
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding MaxPages, Converter={StaticResource IntEq}, ConverterParameter=50}">
                            <Setter Property="Background" Value="{StaticResource Primary}" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </Button>
                  <Button CommandParameter="999" Command="{Binding SetPagesCommand}" IsEnabled="{Binding IsReady}">
                    <FrameworkElement.Style>
                      <Style BasedOn="{StaticResource BtnPill}" TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#FFF3E0" />
                        <Setter Property="Foreground" Value="{StaticResource Warn}" />
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding MaxPages, Converter={StaticResource IntEq}, ConverterParameter=999}">
                            <Setter Property="Background" Value="{StaticResource Warn}" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                    <ContentControl.Content>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡ " VerticalAlignment="Center" />
                        <TextBlock Text="Все страницы" VerticalAlignment="Center" />
                      </StackPanel>
                    </ContentControl.Content>
                  </Button>
                </WrapPanel>
                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource TextSub}">
                  <Run Text="Выбрано: " /> <Run Text="{Binding MaxPages, Mode=OneWay}" /> <Run Text=" стр. ≈ " /> <Run Text="{Binding EstimatedListings, Mode=OneWay}" /> <Run Text=" объявлений" /></TextBlock>
                
                <CheckBox Content="Загружать контакты (только для кандидатов на покупку)" FontSize="13" Foreground="{StaticResource TextMain}" Margin="0,14,0,0" VerticalContentAlignment="Center" IsChecked="{Binding FetchDetails}" />
                
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <CheckBox Content="Включить фоновый авто-мониторинг" FontSize="13" Foreground="{StaticResource TextMain}" VerticalContentAlignment="Center" IsChecked="{Binding IsAutoMonitoring, Mode=TwoWay}" />
                  <TextBlock Text="   Интервал:" FontSize="13" Foreground="{StaticResource TextMain}" VerticalAlignment="Center" Visibility="{Binding IsAutoMonitoring, Converter={StaticResource BoolVis}}" />
                  <ComboBox Width="100" Height="26" Margin="10,0,0,0" VerticalContentAlignment="Center" FontSize="12" ItemsSource="{Binding IntervalOptions}" SelectedItem="{Binding SelectedIntervalString, Mode=TwoWay}" Visibility="{Binding IsAutoMonitoring, Converter={StaticResource BoolVis}}" />
                </StackPanel>

                <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource TextSub}" TextWrapping="Wrap">Фильтры применяются автоматически: категория «Смартфоны», состояние «новые и б/у», цена 1 000–5 000 лей (MDL). На одной странице ≈ 70–78 объявлений.<LineBreak />⚡ Режим «Все страницы» — парсит до конца, остановится сам когда объявления кончатся.</TextBlock>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="24" Margin="0,0,0,24">
              <StackPanel>
                <TextBlock Text="Черный список номеров" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,8" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSub}">Объявления с этими номерами будут исключены из анализа. Добавлять номера можно во вкладке «Черный список».</TextBlock>
                <TextBlock FontSize="13" Foreground="{StaticResource Primary}" Margin="0,8,0,0" FontWeight="SemiBold" Text="{Binding Blacklist.Count, StringFormat=Номеров в списке: {0}}" />
              </StackPanel>
            </Border>
            <Button Style="{StaticResource Btn}" Width="260" Height="48" FontSize="16" HorizontalAlignment="Left" Command="{Binding StartCommand}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🚀 " FontSize="16" VerticalAlignment="Center" />
                <TextBlock Text="Запустить анализ" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Border Margin="0,16,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
              <ProgressBar IsIndeterminate="True" Height="4" Foreground="{StaticResource Accent}" Background="#00FFFFFF" BorderThickness="0" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="📊 Результаты" Style="{StaticResource TI}">
        <ScrollViewer>
          <StackPanel>
            <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="40" Visibility="{Binding HasResult, Converter={StaticResource BoolHide}}">
              <TextBlock Text="Запустите анализ во вкладке «Анализ»" FontSize="15" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center" />
            </Border>
            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">
              <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource BgCard}" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                  <StackPanel>
                    <TextBlock Text="Всего" FontSize="11" Foreground="{StaticResource TextSub}" />
                    <TextBlock FontSize="30" FontWeight="Bold" Foreground="{StaticResource Primary}" Text="{Binding Result.TotalListings}" />
                    <TextBlock Text="объявлений" FontSize="11" Foreground="{StaticResource TextSub}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource BgCard}" CornerRadius="10" Padding="16" Margin="8,0">
                  <StackPanel>
                    <TextBlock Text="Частных" FontSize="11" Foreground="{StaticResource TextSub}" />
                    <TextBlock FontSize="30" FontWeight="Bold" Foreground="{StaticResource Accent}" Text="{Binding Result.PrivateListings}" />
                    <TextBlock Text="продавцов" FontSize="11" Foreground="{StaticResource TextSub}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource BgCard}" CornerRadius="10" Padding="16" Margin="8,0">
                  <StackPanel>
                    <TextBlock Text="Медиана цены" FontSize="11" Foreground="{StaticResource TextSub}" />
                    <TextBlock FontSize="30" FontWeight="Bold" Foreground="{StaticResource Primary}">
                      <Run Text="{Binding Result.MedianPrice, StringFormat={}{0:F0}, Mode=OneWay}" /> <Run Text=" lei" FontSize="14" Foreground="{StaticResource TextSub}" /></TextBlock>
                    <TextBlock Text="все частные" FontSize="11" Foreground="{StaticResource TextSub}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="{StaticResource BgCard}" CornerRadius="10" Padding="16" Margin="8,0,0,0">
                  <StackPanel>
                    <TextBlock Text="Перекупщиков" FontSize="11" Foreground="{StaticResource TextSub}" />
                    <TextBlock FontSize="30" FontWeight="Bold" Foreground="{StaticResource Warn}" Text="{Binding Result.ChronicSellers.Count}" />
                    <TextBlock Text="выявлено" FontSize="11" Foreground="{StaticResource TextSub}" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="Ценовой диапазон (частные объявления)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,12" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource BgStripe}" CornerRadius="6" Padding="12" Margin="0,0,4,0">
                      <StackPanel>
                        <TextBlock Text="Минимум" FontSize="11" Foreground="{StaticResource TextSub}" />
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource Accent}">
                          <Run Text="{Binding Result.MinPrice, StringFormat={}{0:F0}, Mode=OneWay}" /> <Run Text=" lei" FontSize="11" /></TextBlock>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource BgStripe}" CornerRadius="6" Padding="12" Margin="4,0">
                      <StackPanel>
                        <TextBlock Text="Средняя" FontSize="11" Foreground="{StaticResource TextSub}" />
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource Primary}">
                          <Run Text="{Binding Result.AveragePrice, StringFormat={}{0:F0}, Mode=OneWay}" /> <Run Text=" lei" FontSize="11" /></TextBlock>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource BgStripe}" CornerRadius="6" Padding="12" Margin="4,0">
                      <StackPanel>
                        <TextBlock Text="Медиана" FontSize="11" Foreground="{StaticResource TextSub}" />
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource Primary}">
                          <Run Text="{Binding Result.MedianPrice, StringFormat={}{0:F0}, Mode=OneWay}" /> <Run Text=" lei" FontSize="11" /></TextBlock>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="{StaticResource BgStripe}" CornerRadius="6" Padding="12" Margin="4,0,0,0">
                      <StackPanel>
                        <TextBlock Text="Максимум" FontSize="11" Foreground="{StaticResource TextSub}" />
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource Danger}">
                          <Run Text="{Binding Result.MaxPrice, StringFormat={}{0:F0}, Mode=OneWay}" /> <Run Text=" lei" FontSize="11" /></TextBlock>
                      </StackPanel>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="Распределение по брендам" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,12" />
                  <Border Background="{StaticResource Primary}" CornerRadius="6,6,0,0" Padding="12,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Бренд" Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="12" />
                      <TextBlock Grid.Column="1" Text="Кол-во" Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="12" />
                      <TextBlock Grid.Column="2" Text="Доля %" Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="12" />
                      <TextBlock Grid.Column="3" Text="Медиана" Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="12" />
                      <TextBlock Grid.Column="4" Text="Мин" Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="12" />
                      <TextBlock Grid.Column="5" Text="Макс" Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="12" />
                    </Grid>
                  </Border>
                  <ItemsControl ItemsSource="{Binding Result.BrandStats}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Padding="12,8">
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type Border}">
                              <Setter Property="Background" Value="#FFFFFFFF" />
                              <Style.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter Property="Background" Value="{StaticResource BgStripe}" />
                                </Trigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="150" />
                              <ColumnDefinition Width="70" />
                              <ColumnDefinition Width="80" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="90" />
                              <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Text="{Binding Brand}" />
                            <TextBlock Grid.Column="1" FontSize="13" Foreground="{StaticResource Primary}" Text="{Binding Count}" />
                            <TextBlock Grid.Column="2" FontSize="13" Foreground="{StaticResource TextSub}" Text="{Binding Percent, StringFormat={}{0:F1}%}" />
                            <TextBlock Grid.Column="3" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Primary}" Text="{Binding MedianPrice, StringFormat={}{0:F0} l}" />
                            <TextBlock Grid.Column="4" FontSize="12" Foreground="{StaticResource Accent}" Text="{Binding MinPrice, StringFormat={}{0:F0} l}" />
                            <TextBlock Grid.Column="5" FontSize="12" Foreground="{StaticResource Danger}" Text="{Binding MaxPrice, StringFormat={}{0:F0} l}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="20" Margin="0,0,0,16" Visibility="{Binding HasViewsData, Converter={StaticResource BoolVis}}">
                <StackPanel>
                  <TextBlock Text="📊 Распределение по просмотрам (горячие предложения)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,14" />
                  <ItemsControl ItemsSource="{Binding ViewsDistribution}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" FontSize="12" Foreground="{StaticResource TextSub}" VerticalAlignment="Center" Text="{Binding Label}" />
                          <ProgressBar Grid.Column="1" Height="22" Minimum="0" Maximum="1" Foreground="{StaticResource Primary}" Background="#EEF2FF" BorderThickness="0" Margin="0,0,8,0" Value="{Binding Fraction}" />
                          <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Primary}" VerticalAlignment="Center" Text="{Binding CountLabel}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="20" Margin="0,0,0,16" Visibility="{Binding HasHotDeals, Converter={StaticResource BoolVis}}">
                <StackPanel>
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource Warn}">
                        <Run Text="🔥 Горячие предложения — " /> <Run Foreground="{StaticResource Primary}" Text="{Binding FilteredCount, Mode=OneWay}" /> <Run Text=" шт." /></TextBlock>
                      <TextBlock Text="рекомендация на основе отклонения, просмотров и АКБ" FontSize="11" Foreground="{StaticResource TextSub}" Margin="0,1,0,0" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Content="👁 По просмотрам" VerticalAlignment="Center" Padding="10,4" FontSize="11" Foreground="{StaticResource Primary}" BorderBrush="{StaticResource Primary}" IsChecked="{Binding SortByViews, Mode=TwoWay}" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Показать от" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSub}" Margin="0,0,8,0" />
                    <Button Content="Все" CommandParameter="0" Margin="0,0,4,0" Padding="10,4" FontSize="11" Style="{StaticResource BtnPill}" Command="{Binding SetMinViewsCommand}" Background="{Binding MinViews, Converter={StaticResource IntEqBg}, ConverterParameter=0}" Foreground="{Binding MinViews, Converter={StaticResource IntEqFg}, ConverterParameter=0}" />
                    <Button Content="50+ 👁" CommandParameter="50" Margin="0,0,4,0" Padding="10,4" FontSize="11" Style="{StaticResource BtnPill}" Command="{Binding SetMinViewsCommand}" Background="{Binding MinViews, Converter={StaticResource IntEqBg}, ConverterParameter=50}" Foreground="{Binding MinViews, Converter={StaticResource IntEqFg}, ConverterParameter=50}" />
                    <Button Content="100+ 👁" CommandParameter="100" Margin="0,0,4,0" Padding="10,4" FontSize="11" Style="{StaticResource BtnPill}" Command="{Binding SetMinViewsCommand}" Background="{Binding MinViews, Converter={StaticResource IntEqBg}, ConverterParameter=100}" Foreground="{Binding MinViews, Converter={StaticResource IntEqFg}, ConverterParameter=100}" />
                    <Button Content="150+ 👁" CommandParameter="150" Margin="0,0,4,0" Padding="10,4" FontSize="11" Style="{StaticResource BtnPill}" Command="{Binding SetMinViewsCommand}" Background="{Binding MinViews, Converter={StaticResource IntEqBg}, ConverterParameter=150}" Foreground="{Binding MinViews, Converter={StaticResource IntEqFg}, ConverterParameter=150}" />
                    <Button Content="200+ 👁" CommandParameter="200" Padding="10,4" FontSize="11" Style="{StaticResource BtnPill}" Command="{Binding SetMinViewsCommand}" Background="{Binding MinViews, Converter={StaticResource IntEqBg}, ConverterParameter=200}" Foreground="{Binding MinViews, Converter={StaticResource IntEqFg}, ConverterParameter=200}" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding FilteredHotDeals}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{StaticResource BgStripe}" CornerRadius="6" Padding="12" Margin="0,0,0,6">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="90" />
                              <ColumnDefinition Width="80" />
                              <ColumnDefinition Width="80" />
                              <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                              <TextBlock FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,0,2">
                                <Hyperlink Foreground="{StaticResource Primary}" Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Url}">
                                  <Run Text="{Binding Title, Mode=OneWay}" />
                                </Hyperlink>
                              </TextBlock>
                              <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Border CornerRadius="4" Padding="5,1" Margin="0,0,5,0" Background="#EEF2FF">
                                  <FrameworkElement.Style>
                                    <Style TargetType="{x:Type Border}">
                                      <Style.Triggers>
                                        <DataTrigger Value="" Binding="{Binding StorageLabel}">
                                          <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </FrameworkElement.Style>
                                  <TextBlock FontSize="10" Foreground="{StaticResource Primary}" FontWeight="SemiBold" Text="{Binding StorageLabel}" />
                                </Border>
                                <Border CornerRadius="4" Padding="5,1" Margin="0,0,5,0" Background="#F0FDF4">
                                  <FrameworkElement.Style>
                                    <Style TargetType="{x:Type Border}">
                                      <Style.Triggers>
                                        <DataTrigger Value="" Binding="{Binding AgeLabel}">
                                          <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </FrameworkElement.Style>
                                  <TextBlock FontSize="10" Foreground="{StaticResource Accent}" Text="{Binding AgeLabel}" />
                                </Border>
                                <StackPanel Name="ContactPanel" Orientation="Horizontal">
                                  <FrameworkElement.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                      <Style.Triggers>
                                        <DataTrigger Value="" Binding="{Binding PhoneNumber}">
                                          <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PhoneNumber}" Value="{x:Null}">
                                          <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </FrameworkElement.Style>
                                  <TextBlock FontSize="11" Foreground="{StaticResource TextSub}" Margin="0,0,6,0" FontWeight="SemiBold" Text="{Binding SellerName}" />
                                  <TextBlock FontSize="11" Foreground="{StaticResource PrimaryL}" Text="{Binding PhoneNumber}" />
                                </StackPanel>
                              </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource Primary}" VerticalAlignment="Center" Text="{Binding Brand}" />
                            <Border Grid.Column="4" Background="#F0F9FF" CornerRadius="4" Padding="4,2" Margin="4,0,0,0" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👁 " FontSize="10" Foreground="{StaticResource Primary}" />
                                <TextBlock FontSize="11" Foreground="{StaticResource Primary}" FontWeight="Bold" Text="{Binding Views}" />
                              </StackPanel>
                            </Border>
                            <TextBlock Grid.Column="2" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Text="{Binding PriceValue, StringFormat={}{0:F0} lei}" />
                            <Border Grid.Column="3" Background="#FFF3E0" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                              <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource Warn}" HorizontalAlignment="Center" Text="{Binding DiscountPercent, StringFormat=-{0:F0}%}" />
                            </Border>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="20" Margin="0,0,0,16" Visibility="{Binding HasChronicSellers, Converter={StaticResource BoolVis}}">
                <StackPanel>
                  <TextBlock Text="⚠️ Выявленные перекупщики" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Danger}" Margin="0,0,0,12" />
                  <ItemsControl ItemsSource="{Binding Result.ChronicSellers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#FFF5F5" CornerRadius="6" Padding="12" Margin="0,0,0,6" BorderBrush="#FFCDD2" BorderThickness="1">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="140" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="90" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Danger}" VerticalAlignment="Center" Text="{Binding PhoneNumber}" />
                            <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource TextMain}" VerticalAlignment="Center" Text="{Binding Reason}" />
                            <TextBlock Grid.Column="2" FontSize="12" Foreground="{StaticResource Warn}" VerticalAlignment="Center" Text="{Binding ListingCount, StringFormat={}{0} объявл.}" />
                            <Button Grid.Column="3" Content="🚫 В ЧС" Style="{StaticResource BtnSm}" Background="{StaticResource Danger}" Height="26" Padding="10,2" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding DataContext.AddToBlacklistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="📱 Объявления" Style="{StaticResource TI}">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{StaticResource BgCard}" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="🔍 Фильтр по бренду:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="0,0,10,0" />
              <ComboBox Width="140" Height="32" VerticalContentAlignment="Center" FontSize="13" ItemsSource="{Binding BrandFilterOptions}" SelectedItem="{Binding SelectedBrandFilter, Mode=TwoWay}" />

              <TextBlock Text="🔍 Поиск:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="20,0,10,0" />
              <TextBox Width="150" Height="32" VerticalContentAlignment="Center" FontSize="13" Style="{StaticResource TB}" Text="{Binding SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

              <TextBlock Text="⇅ Сортировка:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="20,0,10,0" />
              <ComboBox Width="150" Height="32" VerticalContentAlignment="Center" FontSize="13" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}" />
            </StackPanel>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="40" Visibility="{Binding HasResult, Converter={StaticResource BoolHide}}">
                <TextBlock Text="Запустите анализ во вкладке «Анализ» для просмотра объявлений" FontSize="15" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center" />
              </Border>
              <Border Background="{StaticResource Primary}" CornerRadius="6,6,0,0" Padding="12,8" Margin="0,0,0,2" Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="200" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Объявление" Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="12" />
                  <TextBlock Grid.Column="1" Text="Бренд / Модель" Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="12" />
                  <TextBlock Grid.Column="2" Text="Телефон" Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="12" />
                  <TextBlock Grid.Column="3" Text="Цена" Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="12" />
                  <TextBlock Grid.Column="4" Text="Анализ цены" Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="12" />
                </Grid>
              </Border>
              <ItemsControl Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}" ItemsSource="{Binding FilteredListingsList}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#FFFFFFFF" CornerRadius="4" Padding="12,10" Margin="0,0,0,4" BorderThickness="0,0,0,1" BorderBrush="#EEEEEE">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type Border}">
                          <Style.Triggers>
                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                              <Setter Property="Background" Value="{StaticResource BgStripe}" />
                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="150" />
                          <ColumnDefinition Width="120" />
                          <ColumnDefinition Width="90" />
                          <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                          <TextBlock FontSize="13" TextTrimming="CharacterEllipsis">
                            <Hyperlink Foreground="{StaticResource Primary}" Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Url}">
                              <Run Text="{Binding Title, Mode=OneWay}" />
                            </Hyperlink>
                          </TextBlock>
                          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Border CornerRadius="4" Padding="5,1" Margin="0,0,5,0" Background="#EEF2FF">
                              <FrameworkElement.Style>
                                <Style TargetType="{x:Type Border}">
                                  <Style.Triggers>
                                    <DataTrigger Value="" Binding="{Binding StorageLabel}">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </FrameworkElement.Style>
                              <TextBlock FontSize="10" Foreground="{StaticResource Primary}" FontWeight="SemiBold" Text="{Binding StorageLabel}" />
                            </Border>
                            <Border CornerRadius="4" Padding="5,1" Margin="0,0,5,0" Background="#F0FDF4">
                              <FrameworkElement.Style>
                                <Style TargetType="{x:Type Border}">
                                  <Style.Triggers>
                                    <DataTrigger Value="" Binding="{Binding AgeLabel}">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </FrameworkElement.Style>
                              <TextBlock FontSize="10" Foreground="{StaticResource Accent}" Text="{Binding AgeLabel}" />
                            </Border>
                            <Border CornerRadius="4" Padding="5,1" Background="#F0F9FF">
                              <FrameworkElement.Style>
                                <Style TargetType="{x:Type Border}">
                                  <Style.Triggers>
                                    <DataTrigger Value="0" Binding="{Binding Views}">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </FrameworkElement.Style>
                              <TextBlock FontSize="10" Foreground="{StaticResource Primary}" Text="{Binding Views, StringFormat=👁 {0}}" />
                            </Border>
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock FontSize="13" FontWeight="Bold" Foreground="{StaticResource Primary}" Text="{Binding Brand}" />
                          <TextBlock FontSize="11" Foreground="{StaticResource TextSub}" Text="{Binding Model}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryL}" Text="{Binding PhoneNumber}" />
                          <TextBlock FontSize="10" Foreground="{StaticResource TextSub}" TextTrimming="CharacterEllipsis" Text="{Binding SellerName}" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Text="{Binding PriceDisplay}" />
                        <Border Grid.Column="4" CornerRadius="4" Padding="8,4" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding ComparisonBg}" BorderBrush="{Binding ComparisonColor}">
                          <TextBlock FontSize="11" FontWeight="Bold" Text="{Binding ComparisonText}" Foreground="{Binding ComparisonColor}" />
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="🚫 Черный список" Style="{StaticResource TI}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="20" Margin="0,0,12,0">
            <StackPanel>
              <TextBlock Text="Добавить номер" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,14" />
              <TextBlock Text="Номер телефона" FontSize="12" Foreground="{StaticResource TextSub}" Margin="0,0,0,4" />
              <TextBox Style="{StaticResource TB}" Margin="0,0,0,12" Text="{Binding NewBlacklistNumber, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="Причина (необязательно)" FontSize="12" Foreground="{StaticResource TextSub}" Margin="0,0,0,4" />
              <TextBox Style="{StaticResource TB}" Margin="0,0,0,16" Text="{Binding NewBlacklistReason}" />
              <Button Content="➕ Добавить" Style="{StaticResource Btn}" Height="36" Command="{Binding AddBlacklistCommand}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Background="{StaticResource BgCard}" CornerRadius="10" Padding="20">
            <StackPanel>
              <TextBlock Text="Список номеров" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,4" />
              <TextBlock FontSize="12" Foreground="{StaticResource TextSub}" Margin="0,0,0,12" Text="{Binding Blacklist.Count, StringFormat=Всего: {0} номеров}" />
              <TextBlock Text="Список пуст — добавьте номера коммерческих продавцов" FontSize="13" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center" Margin="0,20" Visibility="{Binding Blacklist.Count, Converter={StaticResource ZeroHide}}" />
              <ScrollViewer MaxHeight="500">
                <ItemsControl ItemsSource="{Binding Blacklist}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource BgStripe}" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock FontSize="13" FontWeight="Bold" Foreground="{StaticResource Danger}" Text="{Binding PhoneNumber}" />
                            <TextBlock FontSize="11" Foreground="{StaticResource TextSub}" Text="{Binding Reason}" />
                          </StackPanel>
                          <Button Grid.Column="1" Content="✕" Width="28" Height="28" Background="#FFEBEE" Foreground="{StaticResource Danger}" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.RemoveBlacklistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="📋 Лог" Style="{StaticResource TI}">
        <Border Background="#1A1B2E" CornerRadius="10" Padding="16">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Log}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#C8D6E5" Margin="0,1" Text="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </TabItem>
    </TabControl>
    <ProgressBar Grid.Row="2" Maximum="100" Height="4" BorderThickness="0" Background="{StaticResource Border}" Foreground="{StaticResource Primary}" Value="{Binding Progress}" />
    <Border Grid.Row="3" Background="#FFFFFFFF" Padding="16,6" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Border}">
      <TextBlock FontSize="11" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center" Text="{Binding SummaryText}" />
    </Border>
  </Grid>
</Window>
